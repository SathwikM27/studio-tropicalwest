# Copy to .env.local and fill in once the Sanity project exists.
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, sections fall back to the
# local seed data in src/lib/data/ so the site renders with real content
# from day one.
#
# To create the project: npx sanity login (opens a browser, free signup),
# then npx sanity init — paste the project ID it prints below. The content
# editor lives at /studio once this is set.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# From Google Analytics: Admin > Data Streams > your web stream. Page views
# and route changes are tracked automatically once this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
